# ---------------------------------------------------------------------------
# Church Finance System — backend environment
# Copy to `.env` and adjust for your machine.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
PROJECT_NAME="Church Finance System API"
VERSION="1.0.0"
# development | staging | production | test
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# --- Database --------------------------------------------------------------
# Async DSN used by the application.
DATABASE_URL="postgresql+asyncpg://postgres:12039@localhost:5432/churchfinance"
# Optional blocking DSN for Alembic / scripts. Leave empty to derive it
# automatically from DATABASE_URL.
DATABASE_SYNC_URL=""

# --- Security --------------------------------------------------------------
# Generate a new value for every environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="change-me-to-a-long-random-string-of-at-least-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30
# Development convenience: returns the reset link in the API response so the
# flow can be tested without a mail server. ALWAYS false in production.
RETURN_RESET_LINK_IN_RESPONSE=true

# --- Registration ----------------------------------------------------------
# Everyone who signs in sees the same church ledger. Turn this off and create
# accounts manually if that is not what you want.
ALLOW_PUBLIC_REGISTRATION=true

# --- Frontend / CORS -------------------------------------------------------
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Outbound email (password resets) --------------------------------------
# Leave SMTP_HOST empty to log the reset link instead of sending email.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=true
SMTP_FROM_EMAIL="no-reply@example.com"
SMTP_FROM_NAME="Church Finance System"
